# FoloToy AI Passport (ESP32-C3, 8MB Flash, No PSRAM) defaults
CONFIG_IDF_TARGET="esp32c3"
CONFIG_BOARD_TYPE_FOLOTOY_AI_PASSPORT=y

# 8MB Flash & custom partition table (factory + assets + study_fonts)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/8m_ai_passport_study.csv"

# Native USB-Serial-JTAG console (UART0 TX=GPIO21 conflicts with LCD backlight!)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Disable local wake word on single-core no-PSRAM C3 (use OK key to talk)
CONFIG_USE_ESP_WAKE_WORD=n

# LVGL uses system heap malloc (avoids 24KB static pool exhaustion on rounded masks)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_FLASH_DEFAULT_ASSETS=y

# Memory-tight Wi-Fi / LWIP / TLS tuning for ESP32-C3 (no PSRAM)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=768
CONFIG_LWIP_IPV6=n
